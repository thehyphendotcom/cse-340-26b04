{"id":-1,"name":"FROM_FILE","userId":-1,"createdAt":"","updatedAt":"","content":{"items":[{"uid":"re2mYiw7Rq","position":{"x":null,"y":null},"sizes":{"width":400,"height":627},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"src/models/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"projects.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"const createProject = async (title, description, location, date, organizationId) => {\n    const query = `\n      INSERT INTO project (title, description, location, date, organization_id)\n      VALUES ($1, $2, $3, $4, $5)\n      RETURNING project_id;\n    `;\n\n    const queryParams = [title, description, location, date, organizationId];\n    const result = await db.query(query, queryParams);\n\n    if (result.rows.length === 0) {\n        throw new Error('Failed to create project');\n    }\n\n    if (process.env.ENABLE_SQL_LOGGING === 'true') {\n        console.log('Created new project with ID:', result.rows[0].project_id);\n    }\n\n    return result.rows[0].project_id;\n};\n"}]}]},"nodeType":"block"},{"uid":"po8Oec3CvM","position":{"x":590,"y":270},"sizes":{"width":400,"height":84.5},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"Parameterized queries"}]}]},"nodeType":"block"},{"uid":"fewHX53WE2","position":{"x":-70,"y":810},"sizes":{"width":540,"height":662},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/controllers/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"projects.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"const showNewProjectForm = async (req, res) => {\n    const organizations = await getAllOrganizations();\n    const title = 'Add New Service Project';\n\n    res.render('new-project', { title, organizations });\n};\n\nconst processNewProjectForm = async (req, res) => {\n    // Extract form data from the request body\n    const { title, description, location, date, organizationId } = req.body;\n\n    try {\n        // Create the new project in the database\n        const newProjectId = await createProject(title, description, location, date, organizationId);\n\n        req.flash('success', 'New service project created successfully!');\n        res.redirect(`/project/${newProjectId}`);\n    } catch (error) {\n        console.error('Error creating new project:', error);\n        req.flash('error', 'There was an error creating the service project.');\n        res.redirect('/new-project');\n    }\n};\n\nexport { showProjectsPage, showProjectDetailsPage, showNewProjectForm, processNewProjectForm };"}]}]},"nodeType":"block"},{"uid":"PtwVWTM4gS","position":{"x":0,"y":1590},"sizes":{"width":400,"height":277},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"routes.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"\n// Route for new project page\nrouter.get('/new-project', showNewProjectForm);\n\n// Route to handle new project form submission\nrouter.post('/new-project', processNewProjectForm);\n"}]}]},"nodeType":"block"},{"uid":"TKBWpvoZaY","position":{"x":630,"y":1670},"sizes":{"width":400,"height":109},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"src/views/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"new-project.ejs"}]},{"type":"paragraph","content":[{"type":"text","text":" "}]}]},"nodeType":"block"},{"uid":"CdOb_tra20","position":{"x":750,"y":760},"sizes":{"width":400,"height":732},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/controllers/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"projects.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"const projectValidation = [\n    body('title')\n        .trim()\n        .notEmpty().withMessage('Title is required')\n        .isLength({ min: 3, max: 200 }).withMessage('Title must be between 3 and 200 characters'),\n    body('description')\n        .trim()\n        .notEmpty().withMessage('Description is required')\n        .isLength({ max: 1000 }).withMessage('Description must be less than 1000 characters'),\n    body('location')\n        .trim()\n        .notEmpty().withMessage('Location is required')\n        .isLength({ max: 200 }).withMessage('Location must be less than 200 characters'),\n    body('date')\n        .notEmpty().withMessage('Date is required')\n        .isISO8601().withMessage('Date must be a valid date format'),\n    body('organizationId')\n        .notEmpty().withMessage('Organization is required')\n        .isInt().withMessage('Organization must be a valid integer')\n];\n"}]}]},"nodeType":"block"},{"uid":"fRexJx2qFA","position":{"x":10.768005247917813,"y":1075.040667537901},"sizes":{"width":400,"height":364.5},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/controllers/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"projects.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"// Check for validation errors\nconst errors = validationResult(req);\nif (!errors.isEmpty()) {\n    // Loop through validation errors and flash them\n    errors.array().forEach((error) => {\n        req.flash('error', error.msg);\n    });\n\n    // Redirect back to the new project form\n    return res.redirect('/new-project');\n};\n"}]}]},"nodeType":"block"},{"uid":"jEGt5uf5TK","position":{"x":-730,"y":950},"sizes":{"width":400,"height":364.5},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/controllers/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"projects.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"// Check for validation errors\nconst errors = validationResult(req);\nif (!errors.isEmpty()) {\n    // Loop through validation errors and flash them\n    errors.array().forEach((error) => {\n        req.flash('error', error.msg);\n    });\n\n    // Redirect back to the new project form\n    return res.redirect('/new-project');\n};\n"}]}]},"nodeType":"block"}],"configs":{"centerX":836.5599834519478,"centerY":-1176.9269327860234,"zoomLevel":1.3333333333333335},"arrowData":{"arrowsMap":{},"pointsMap":{},"edgesMap":{"edge-po8Oec3CvM-po8Oec3CvM-left-re2mYiw7Rq-re2mYiw7Rq-right":{"uid":"edge-po8Oec3CvM-po8Oec3CvM-left-re2mYiw7Rq-re2mYiw7Rq-right","fromNodeId":"po8Oec3CvM","fromHandleId":"po8Oec3CvM-left","toNodeId":"re2mYiw7Rq","toHandleId":"re2mYiw7Rq-right","direction":"ft","selectable":true,"type":"solid","content":{"label":""}},"edge-re2mYiw7Rq-re2mYiw7Rq-bottom-fewHX53WE2-fewHX53WE2-top":{"uid":"edge-re2mYiw7Rq-re2mYiw7Rq-bottom-fewHX53WE2-fewHX53WE2-top","fromNodeId":"re2mYiw7Rq","fromHandleId":"re2mYiw7Rq-bottom","toNodeId":"fewHX53WE2","toHandleId":"fewHX53WE2-top","direction":"ft","selectable":true,"type":"solid","content":{"label":""}},"edge-fewHX53WE2-fewHX53WE2-bottom-PtwVWTM4gS-PtwVWTM4gS-top":{"uid":"edge-fewHX53WE2-fewHX53WE2-bottom-PtwVWTM4gS-PtwVWTM4gS-top","fromNodeId":"fewHX53WE2","fromHandleId":"fewHX53WE2-bottom","toNodeId":"PtwVWTM4gS","toHandleId":"PtwVWTM4gS-top","direction":"ft","selectable":true,"type":"solid","content":{"label":""}},"edge-TKBWpvoZaY-TKBWpvoZaY-left-PtwVWTM4gS-PtwVWTM4gS-right":{"uid":"edge-TKBWpvoZaY-TKBWpvoZaY-left-PtwVWTM4gS-PtwVWTM4gS-right","fromNodeId":"TKBWpvoZaY","fromHandleId":"TKBWpvoZaY-left","toNodeId":"PtwVWT