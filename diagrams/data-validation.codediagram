{"id":-1,"name":"FROM_FILE","userId":-1,"createdAt":"","updatedAt":"","content":{"items":[{"uid":"0J2tv7lshy","position":{"x":-320,"y":1170},"sizes":{"width":1100,"height":172},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"routes.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"import { showOrganizationsPage, showNewOrganizationForm, processNewOrganizationForm, organizationValidation } from './controllers/organizations.js';\n"}]}]},"nodeType":"block"},{"uid":"x_mygES30c","position":{"x":-10,"y":-70},"sizes":{"width":490,"height":172},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"src/controllers/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"organizations.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"import { body, validationResult } from 'express-validator';\n"}]}]},"nodeType":"block"},{"uid":"geLjMkQylp","position":{"x":-70,"y":190},"sizes":{"width":607.25,"height":539.5},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/controllers/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"organizations.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"// Define validation and sanitization rules for organization form\n// Define validation rules for organization form\nconst organizationValidation = [\n    body('name')\n        .trim()\n        .notEmpty()\n        .withMessage('Organization name is required')\n        .isLength({ min: 3, max: 150 })\n        .withMessage('Organization name must be between 3 and 150 characters'),\n    body('description')\n        .trim()\n        .notEmpty()\n        .withMessage('Organization description is required')\n        .isLength({ max: 500 })\n        .withMessage('Organization description cannot exceed 500 characters'),\n    body('contactEmail')\n        .normalizeEmail()\n        .notEmpty()\n        .withMessage('Contact email is required')\n        .isEmail()\n        .withMessage('Please provide a valid email address')\n];\n"}]}]},"nodeType":"block"},{"uid":"lMRjsRSRDD","position":{"x":-150,"y":840},"sizes":{"width":770,"height":172},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/controllers/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"organizations.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"export { showOrganizationsPage, showOrganizationDetailsPage, showNewOrganizationForm, processNewOrganizationForm, organizationValidation };"}]}]},"nodeType":"block"},{"uid":"Wh2E8rqbL1","position":{"x":30,"y":1460},"sizes":{"width":400,"height":242},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"routes.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"// Route to handle new organization form submission\nrouter.post('/new-organization', organizationValidation, processNewOrganizationForm);\n"}]}]},"nodeType":"block"},{"uid":"Hz9_05b7nE","position":{"x":700,"y":1430},"sizes":{"width":400,"height":347},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/controllers/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"organizations.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"// Check for validation errors\nconst results = validationResult(req);\nif (!results.isEmpty()) {\n    // Validation failed - loop through errors\n    results.array().forEach((error) => {\n        req.flash('error', error.msg);\n    });\n\n    // Redirect back to the new organization form\n    return res.redirect('/new-organization');\n};\n"}]}]},"nodeType":"block"},{"uid":"UkFrWG5dsk","position":{"x":1360,"y":1270},"sizes":{"width":400,"height":679.5},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/views/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"new-organization.ejs"}]},{"type":"codeBlock","attrs":{"language":"ejs","wrapCode":true},"content":[{"type":"text","text":"<form action=\"/new-organization\" method=\"POST\">\n   <div class=\"form-group\">\n     <label for=\"name\">Organization Name</label>\n     <input\n       type=\"text\"\n       id=\"name\"\n       name=\"name\"\n       required\n       maxlength=\"150\"\n     />\n   </div>\n\n   <div class=\"form-group\">\n     <label for=\"description\">Description</label>\n     <textarea\n       id=\"description\"\n       name=\"description\"\n       required\n       maxlength=\"500\"\n     ></textarea>\n   </div>\n\n   <div class=\"form-group\">\n     <label for=\"contactEmail\">Contact Email</label>\n     <input\n       type=\"email\"\n       id=\"contactEmail\"\n       name=\"contactEmail\"\n       required\n"}]}]},"nodeType":"block"}],"configs":{"centerX":593.8134647792384,"centerY":-88.01587462082864,"zoomLevel":0.43333333333333335},"arrowData":{"arrowsMap":{},"pointsMap":{},"edgesMap":{"edge-x_mygES30c-x_mygES30c-bottom-geLjMkQylp-geLjMkQylp-top":{"uid":"edge-x_mygES30c-x_mygES30c-bottom-geLjMkQylp-geLjMkQylp-top","fromNodeId":"x_mygES30c","fromHandleId":"x_mygES30c-bottom","toNodeId":"geLjMkQylp","toHandleId":"geLjMkQylp-top","direction":"ft","selectable":true,"type":"solid","content":{"label":""}},"edge-geLjMkQylp-geLjMkQylp-bottom-lMRjsRSRDD-lMRjsRSRDD-top":{"uid":"edge-geLjMkQylp-geLjMkQylp-bottom-lMRjsRSRDD-lMRjsRSRDD-top","fromNodeId":"geLjMkQylp