<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <% if (projectDetails) { %>
        <section>
            <h2><%= projectDetails.title %></h2>

            <p><strong>Description:</strong> <%= projectDetails.description %></p>

            <p><strong>Date:</strong> <%= new Date(projectDetails.date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            }) %></p>

            <p><strong>Location:</strong> <%= projectDetails.location %></p>

            <p><strong>Partner Organization:</strong> <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></p>

            <% if (categories && categories.length > 0) { %>
                <p><strong>Categories:</strong></p>
                <ul>
                    <% categories.forEach(category => { %>
                        <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
                    <% }); %>
                </ul>
            <% } %>

            <% if (isLoggedIn) { %>
                <div style="margin-top: 1.5rem; text-align: center;">
                    <% if (isVolunteering) { %>
                        <p><strong>You are volunteering for this project!</strong></p>
                        <form action="/project/<%= projectDetails.project_id %>/unvolunteer" method="POST" style="max-width:320px; padding:0; border:none; box-shadow:none; background:transparent;">
                            <button type="submit" style="background:#dc3545; width:100%;">Remove yourself as a volunteer</button>
                        </form>
                    <% } else { %>
                        <form action="/project/<%= projectDetails.project_id %>/volunteer" method="POST" style="max-width:320px; padding:0; border:none; box-shadow:none; background:transparent;">
                            <button type="submit" style="width:100%;">Volunteer for this project</button>
                        </form>
                    <% } %>
                </div>
            <% } %>

            <% if (user && user.role_name === 'admin') { %>
                <p style="margin-top: 1.5rem;"><a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a></p>
                <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a></p>
            <% } %>
        </section>
    <% } else { %>
        <p>Service project not found.</p>
    <% } %>
</main>
<%- include('partials/footer') %>