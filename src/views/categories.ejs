

<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <p>Here are our service categories:</p>
        <ul>
            <% categories.forEach(category => { %>
                <li><a href="/category/<%= category.category_id %>"><strong><%= category.name %></strong></a></li>
            <% }); %>
        </ul>
        <p><a href="/new-category">Add New Category</a></p>
    </main>
<%- include('partials/footer') %>