<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>

        <ul>
            <% projects.forEach(project => { %>
                <% const formattedDate = new Date(project.date || project.project_date).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                }); %>
                <li>
                    <strong>
                        <%= formattedDate %>: 
                        <a href="/project/<%= project.project_id %>"><%= project.title %></a> 
                        (<a href="/organization/<%= project.organization_id %>"><em><%= project.organization_name %></em></a>)
                    </strong>
                </li>
            <% }); %>
        </ul>
        <p><a href="/new-project">Add a new project</a></p>
    </main>

<%- include('partials/footer') %>