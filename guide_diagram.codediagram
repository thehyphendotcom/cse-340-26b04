{"id":-1,"name":"FROM_FILE","userId":-1,"createdAt":"","updatedAt":"","content":{"items":[{"uid":"wiM2wmpN3E","position":{"x":80,"y":130},"sizes":{"width":400,"height":78},"autoheight":false,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"src/models/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"projects.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"import db from './db.js';\n\nconst getAllProjects = async () => {\n    const query = `\n    SELECT\n        p.project_id,\n        p.organization_id,\n        p.title,\n        p.description,\n        p.location,\n        p.project_date,\n        o.name AS organization_name\n    FROM public.projects p\n    JOIN public.organization o ON p.organization_id = o.organization_id\n    ORDER BY p.project_date;`;\n\n    const result = await db.query(query);\n    return result.rows;\n};\n\nconst getProjectsByOrganizationId = async (organizationId) => {\n      const query = `\n        SELECT\n          project_id,\n          organization_id,\n          title,\n          description,\n          location,\n          project_date\n        FROM projects\n        WHERE organization_id = $1\n        ORDER BY project_date;\n      `;\n      \n      const queryParams = [organizationId];\n      const result = await db.query(query, queryParams);\n\n      return result.rows;\n};\n\nexport { getAllProjects, getProjectsByOrganizationId };"}]}]},"nodeType":"block"},{"uid":"iPPMt3r7Qq","position":{"x":80,"y":430},"sizes":{"width":400,"height":679.5},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/controllers/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"organizations.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"import {getAllOrganizations, getOrganizationDetails} from '../models/organizations.js';\nimport { getProjectsByOrganizationId } from '../models/projects.js';\n\nconst showOrganizationsPage = async (req, res) => {\n    const organizations = await getAllOrganizations();\n    const title = 'Our Partner Organizations';\n\n    res.render('organizations', { title, organizations });\n};\n\nconst showOrganizationDetailsPage = async (req, res) => {\n    const organizationId = req.params.id;\n    const organizationDetails = await getOrganizationDetails(organizationId);\n    const projects = await getProjectsByOrganizationId(organizationId);\n    const title = 'Organization Details';\n\n    res.render('organization', {title, organizationDetails, projects});\n};\n\nexport { showOrganizationsPage, showOrganizationDetailsPage };"}]}]},"nodeType":"block"},{"uid":"V4NYRy8ATR","position":{"x":80,"y":1260},"sizes":{"width":400,"height":109},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"routes.js"}]},{"type":"paragraph","content":[{"type":"text","text":" "}]}]},"nodeType":"block"},{"uid":"yS1moske4n","position":{"x":-1200,"y":1670},"sizes":{"width":470,"height":767},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"src/views/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"new-organization.ejs"}]},{"type":"codeBlock","attrs":{"language":"ejs","wrapCode":true},"content":[{"type":"text","text":"<%- include('partials/header') %>\n<main>\n    <h1><%= title %></h1>\n\n <form action=\"/new-organization\" method=\"POST\">\n    <div class=\"form-group\">\n      <label for=\"name\">Organization Name</label>\n      <input\n        type=\"text\"\n        id=\"name\"\n        name=\"name\"\n      />\n    </div>\n\n    <div class=\"form-group\">\n      <label for=\"description\">Description</label>\n      <textarea\n        id=\"description\"\n        name=\"description\"\n      ></textarea>\n    </div>\n\n    <div class=\"form-group\">\n      <label for=\"contactEmail\">Contact Email</label>\n      <input\n        type=\"text\"\n        id=\"contactEmail\"\n        name=\"contactEmail\"\n      />\n    </div>\n\n    <button type=\"submit\">Create Organization</button>\n  </form>\n\n</main>\n<%- include('partials/footer') %>"}]}]},"nodeType":"block"},{"uid":"_YFgqbNUXJ","position":{"x":-550,"y":1680},"sizes":{"width":430,"height":242},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/controllers/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"organizations.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"const showNewOrganizationForm = async (req, res) => {\n    const title = 'Add New Organization';\n\n    res.render('new-organization', { title });\n};\n"}]}]},"nodeType":"block"},{"uid":"j5_WtwZ6xl","position":{"x":-40,"y":1690},"sizes":{"width":470,"height":189.5},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"routes.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"// Route for new organization page\nrouter.get('/new-organization', showNewOrganizationForm);\n"}]}]},"nodeType":"block"},{"uid":"SCBiHu16pQ","position":{"x":-70,"y":2020},"sizes":{"width":510,"height":172},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"src/views/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"organizations.ejs"}]},{"type":"codeBlock","attrs":{"language":"ejs","wrapCode":true},"content":[{"type":"text","text":"<p><a href=\"/new-organization\">Add a new organization</a></p>\n"}]}]},"nodeType":"block"},{"uid":"JuFhl1sZJB","position":{"x":-400,"y":2360},"sizes":{"width":780,"height":644.5},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/models/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"organizations.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"/**\n * Creates a new organization in the database.\n * @param {string} name - The name of the organization.\n * @param {string} description - A description of the organization.\n * @param {string} contactEmail - The contact email for the organization.\n * @param {string} logoFilename - The filename of the organization's logo.\n * @returns {string} The id of the newly created organization record.\n */\nconst createOrganization = async (name, description, contactEmail, logoFilename) => {\n    const query = `\n      INSERT INTO organization (name, description, contact_email, logo_filename)\n      VALUES ($1, $2, $3, $4)\n      RETURNING organization_id\n    `;\n\n    const queryParams = [name, description, contactEmail, logoFilename];\n    const result = await db.query(query, queryParams);\n\n    if (result.rows.length === 0) {\n        throw new Error('Failed to create organization');\n    }\n\n    if (process.env.ENABLE_SQL_LOGGING === 'true') {\n        console.log('Created new organization with ID:', result.rows[0].organization_id);\n    }\n\n    return result.rows[0].organization_id;\n};\n"}]}]},"nodeType":"block"},{"uid":"zNMAhnuJJo","position":{"x":590,"y":2370},"sizes":{"width":510,"height":207},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"server.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"// Allow Express to receive and process common POST data\napp.use(express.urlencoded({ extended: true }));\napp.use(express.json());\n"}]}]},"nodeType":"block"},{"uid":"JOOFK6Fwxi","position":{"x":600,"y":2730},"sizes":{"width":500,"height":189.5},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"routes.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"// Route for new organization page\nrouter.get('/new-organization', showNewOrganizationForm);\n"}]}]},"nodeType":"block"},{"uid":"6C1HcoYrlN","position":{"x":610,"y":3080},"sizes":{"width":780,"height":277},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/controllers/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"organizations.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"const processNewOrganizationForm = async (req, res) => {\n    const { name, description, contactEmail } = req.body;\n    const logoFilename = 'placeholder-logo.png'; // Use the placeholder logo for all new organizations\n\n    const organizationId = await createOrganization(name, description, contactEmail, logoFilename);\n    res.redirect(`/organization/${organizationId}`);\n};\n"}]}]},"nodeType":"block"},{"uid":"UxzOlJiniC","position":{"x":760,"y":3470},"sizes":{"width":510,"height":189.5},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"routes.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"// Route to handle new organization form submission\nrouter.post('/new-organization', processNewOrganizationForm);\n"}]}]},"nodeType":"block"},{"uid":"-cNsRPJYUL","position":{"x":-680,"y":1560},"sizes":{"width":325.640625,"height":25},"autoheight":true,"blockContent":{"text":"Create a new organization process\n"},"nodeType":"text"},{"uid":"5WNckbM3Rn","position":{"x":-4340,"y":2670},"sizes":{"width":400,"height":84.5},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"npm install express-session"}]}]},"nodeType":"block"},{"uid":"mIC32smDGs","position":{"x":-4330,"y":2860},"sizes":{"width":640,"height":136.5},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"code"}],"text":"node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\""}]}]}]},{"type":"paragraph","content":[{"type":"hardBreak"}]}]},"nodeType":"block"},{"uid":"X05dI-73aq","position":{"x":-4200,"y":3200},"sizes":{"width":400,"height":84.5},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"bold"}],"text":"SESSION_SECRET=your_generated_secret_here"}]}]},"nodeType":"block"},{"uid":"plqZnHIQp2","position":{"x":-4200,"y":3390},"sizes":{"width":400,"height":172},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"server.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"import session from 'express-session';\n"}]}]},"nodeType":"block"},{"uid":"TFxTPgtL35","position":{"x":-4200,"y":3560},"sizes":{"width":400,"height":189.5},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"server.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"const SESSION_SECRET = process.env.SESSION_SECRET || 'default_secret_key';\n"}]}]},"nodeType":"block"},{"uid":"VC8xJdhidt","position":{"x":-4200,"y":3870},"sizes":{"width":400,"height":294.5},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"server.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"// Set up session management\napp.use(session({\n    secret: SESSION_SECRET,\n    resave: false,\n    saveUninitialized: true,\n    cookie: { maxAge: 60 * 60 * 1000 } // Session expires after 1 hour of inactivity\n}));\n"}]}]},"nodeType":"block"},{"uid":"UJyEZp8kuR","position":{"x":-4340,"y":4350},"sizes":{"width":710,"height":1834.5},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/middleware/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"flash.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"/**\n * Flash Message Middleware\n * \n * Provides temporary message storage that survives redirects but is consumed on render.\n * Messages are stored in the session and organized by type (success, error, warning, info).\n * \n * Usage in controllers:\n *   req.flash('success', 'Message text')  // Store a message\n *   req.flash('error')                    // Get all error messages\n *   req.flash()                           // Get all messages (all types)\n */\n\n/**\n * Initialize flash message storage and provide access methods\n */\nconst flashMiddleware = (req, res, next) => {\n    /**\n     * The flash function handles both setting and getting messages\n     * - Called with 2 args (type, message): stores a new message\n     * - Called with 1 arg (type): retrieves and clears messages of that type\n     * - Called with 0 args: retrieves and clears all messages\n     */\n    req.flash = function(type, message) {\n        // Initialize flash storage if it doesn't exist\n        if (!req.session.flash) {\n            req.session.flash = {\n                success: [],\n                error: [],\n                warning: [],\n                info: []\n            };\n        }\n\n        // SETTING: Two arguments means we're storing a new message\n        if (type && message) {\n            // Ensure this message type's array exists\n            if (!req.session.flash[type]) {\n                req.session.flash[type] = [];\n            }\n            // Add the message to the appropriate type array\n            req.session.flash[type].push(message);\n            return;\n        }\n\n        // GETTING ONE TYPE: One argument means retrieve messages of that type\n        if (type && !message) {\n            const messages = req.session.flash[type] || [];\n            // Clear this type's messages after retrieving\n            req.session.flash[type] = [];\n            return messages;\n        }\n\n        // GETTING ALL: No arguments means retrieve all message types\n        const allMessages = req.session.flash || {\n            success: [],\n            error: [],\n            warning: [],\n            info: []\n        };\n\n        // Clear all flash messages after retrieving\n        req.session.flash = {\n            success: [],\n            error: [],\n            warning: [],\n            info: []\n        };\n\n        return allMessages;\n    };\n\n    next();\n}\n\n/**\n * Make flash function available to all templates via res.locals\n * This middleware must run AFTER flashMiddleware\n */\nconst flashLocals = (req, res, next) => {\n    // Attach the flash function to res.locals so templates can access it\n    // The function is NOT called here, just made available\n    // Messages are only consumed when a template calls flash()\n    res.locals.flash = req.flash;\n    next();\n}\n\n/**\n * Combined flash middleware that runs both functions in the correct order\n * Import and use this as a single middleware function in your application\n */\nconst flash = (req, res, next) => {\n    flashMiddleware(req, res, () => {\n        flashLocals(req, res, next);\n    });\n};\n\nexport default flash;"}]}]},"nodeType":"block"},{"uid":"evHx-X4GC9","position":{"x":-4330,"y":6420},"sizes":{"width":400,"height":172},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"server.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"import flash from './src/middleware/flash.js'; \n"}]}]},"nodeType":"block"},{"uid":"EvvEGFQm4b","position":{"x":-4330,"y":6590},"sizes":{"width":400,"height":189.5},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"server.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"// Use flash message middleware\napp.use(flash);\n"}]}]},"nodeType":"block"},{"uid":"0aQYbovXPe","position":{"x":-4320,"y":6960},"sizes":{"width":400,"height":487},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/controllers/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"organizations.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"const processNewOrganizationForm = async (req, res) => {\n    const { name, description, contactEmail } = req.body;\n    const logoFilename = 'placeholder-logo.png'; // Use the placeholder logo for all new organizations\n\n    const organizationId = await createOrganization(name, description, contactEmail, logoFilename);\n\n     // Set a success flash message\n    req.flash('success', 'Organization added successfully!');\n    \n    res.redirect(`/organization/${organizationId}`);\n};\n"}]}]},"nodeType":"block"},{"uid":"mMoWzBliWB","position":{"x":-4310,"y":7530},"sizes":{"width":400,"height":312},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"src/views/partials/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"header.ejs"}]},{"type":"codeBlock","attrs":{"language":"ejs","wrapCode":true},"content":[{"type":"text","text":"  <% const messages = flash(); %>\n<% Object.keys(messages).forEach(type => { %>\n    <% if (messages[type].length > 0) { %>\n        \n            <% messages[type].forEach(msg => { %>\n                <%= msg %>\n            <% }); %>\n        \n    <% } %>\n<% }); %>"}]}]},"nodeType":"block"},{"uid":"TME-T_BDjk","position":{"x":-4320,"y":7940},"sizes":{"width":400,"height":609.5},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"public/css/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"main.css"}]},{"type":"codeBlock","attrs":{"language":"css","wrapCode":true},"content":[{"type":"text","text":"/* Flash message styles */\n.alert {\n    padding: 15px;\n    margin-bottom: 20px;\n    border: 1px solid transparent;\n    border-radius: 4px;\n}\n.alert.success {\n    color: #155724;\n    background-color: #d4edda;\n    border-color: #c3e6cb;\n}\n.alert.error {\n    color: #721c24;\n    background-color: #f8d7da;\n    border-color: #f5c6cb;\n}\n.alert.warning {\n    color: #856404;\n    background-color: #fff3cd;\n    border-color: #ffeeba;\n}\n.alert.info {\n    color: #0c5460;\n    background-color: #d1ecf1;\n    border-color: #bee5eb;\n}"}]}]},"nodeType":"block"}],"configs":{"centerX":2320.0554554245723,"centerY":-3014.434594776111,"zoomLevel":0.4333333333333333},"arrowData":{"arrowsMap":{},"pointsMap":{},"edgesMap":{"edge-wiM2wmpN3E-wiM2wmpN3E-bottom-iPPMt3r7Qq-iPPMt3r7Qq-top":{"uid":"edge-wiM2wmpN3E-wiM2wmpN3E-bottom-iPPMt3r7Qq-iPPMt3r7Qq-top","fromNodeId":"wiM2wmpN3E","fromHandleId":"wiM2wmpN3E-bottom","toNodeId":"iPPMt3r7Qq","toHandleId":"iPPMt3r7Qq-top","dir